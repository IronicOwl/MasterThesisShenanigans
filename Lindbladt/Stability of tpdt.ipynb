    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# --- 1. System Parameters ---\n",
    "omega_c = 1.0\n",
    "omega_a = 1.0\n",
    "k2 = 0.05\n",
    "\n",
    "# Calculate the critical coupling for R=1/2\n",
    "lam_c = np.sqrt(omega_c**2 + 3 * omega_a * k2)\n",
    "print(f\"Critical Coupling (lambda_c): {lam_c:.4f}\")\n",
    "\n",
    "\n"
   ]
